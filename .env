ENVIRONMENT=development

DATABASE_URL=sqlite+pysqlite:///./data/cip.db
REDIS_URL=redis://localhost:6379/0
PARALLEL_STAGES=false

JWT_SECRET=0f8e8bb28b279416fc4a2b1d343d91a6663c9d0b8604e0ea91d80ab7e8a28ee8
FIELD_ENCRYPTION_KEY=

GROQ_API_KEY=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, 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
# Stages 2-6 run on the 8b: separate daily quota bucket (independent of the 70b's,
# which the free tier exhausts quickly) and ~3x fewer tokens per call. OCR + report
# stay on the 70b via GROQ_MODEL_LONG_CONTEXT for its larger per-request cap.
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MODEL_LONG_CONTEXT=llama-3.3-70b-versatile
LLM_SCHEMA_RETRIES=1

CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/documents
S3_BUCKET=
S3_REGION=ap-south-1

BOOTSTRAP_ADMIN_EMAIL=admin@synthx.dev
BOOTSTRAP_ADMIN_PASSWORD=Admin@123
