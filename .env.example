# Copy this file to `.env` at the repo root and fill in your own values:
#   cp .env.example .env
# `.env` is gitignored and must NEVER be committed. This example is the safe template.
#
# The backend resolves `.env` from the repo root regardless of which directory
# you run uvicorn/alembic from.

ENVIRONMENT=development

DATABASE_URL=sqlite+pysqlite:///./data/cip.db
REDIS_URL=redis://localhost:6379/0

# Generate a random one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-please
FIELD_ENCRYPTION_KEY=

# Create an API key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_LONG_CONTEXT=llama-3.3-70b-versatile

CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/documents
S3_BUCKET=
S3_REGION=ap-south-1

# The bootstrap admin created by `python -m app.seed`.
# Use whatever you want here, but remember it - this is what you sign in with.
# You can share this file freely; the real password lives only in each clone's .env.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123
